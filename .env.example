# ============================================================================
# spec2program - Environment configuration (EXAMPLE)
# ----------------------------------------------------------------------------
# Copy this file to ".env" and fill in your real values.
#   cp .env.example .env
# The ".env" file is git-ignored and will never be committed.
# ============================================================================

# Which LLM backend to use:
#   mock       -> deterministic offline generator, NO API key needed (great for demos)
#   openrouter -> OpenRouter.ai (one key, access to many model providers)
#   openai     -> any OpenAI-compatible Chat Completions endpoint directly
LLM_PROVIDER=mock

# --- Settings used only when LLM_PROVIDER is "openrouter" or "openai" ------
# Your API key (leave blank in mock mode).
LLM_API_KEY=

# Base URL of the OpenAI-compatible API.
#   OpenRouter : https://openrouter.ai/api/v1   (ignored when LLM_PROVIDER=openrouter,
#                                                 which always targets OpenRouter directly)
#   OpenAI     : https://api.openai.com/v1
#   Also works with Azure OpenAI (via gateway), Together AI, Groq, Ollama, etc.
LLM_BASE_URL=https://api.openai.com/v1

# Model name to request. The default was chosen by a measured bake-off
# (see README "Choosing the model"), not by reputation: it was the fastest
# candidate that stayed rule-valid on every run, and it costs less per
# generation than the reasoning models because it emits ~790 completion
# tokens rather than ~4400.
#   OpenRouter example : meta-llama/llama-3.3-70b-instruct
#   OpenAI example     : gpt-4o-mini
LLM_MODEL=meta-llama/llama-3.3-70b-instruct
# Sampling temperature (0 = deterministic, higher = more creative).
LLM_TEMPERATURE=0.1

# Request timeout in seconds.
LLM_TIMEOUT=60

# Optional cap on the model's reply length. LEAVE THIS UNSET unless you have
# a specific reason. Reasoning models (including the default
# deepseek-v4-flash) count their hidden reasoning tokens against this budget,
# so a value that looks generous next to the ~1.2k tokens of visible JSON can
# still truncate the reply mid-document - which fails to parse and wastes the
# entire call. One measured run needed 8751 completion tokens for a 4.6 kB
# program. Unset means no cap.
# LLM_MAX_TOKENS=

# --- Performance tuning -----------------------------------------------------
# How many vehicle specs a batch request processes concurrently. Each spec is
# one blocking LLM call, so this overlaps network waits rather than CPU work:
# a fleet of 8 finishes in roughly the time of 1 instead of 8. Lower it if the
# provider starts rate-limiting you.
BATCH_MAX_WORKERS=8

# Size of the shared HTTP connection pool used for LLM calls. Should be at
# least BATCH_MAX_WORKERS so concurrent batch requests never queue on a
# connection.
LLM_MAX_CONNECTIONS=20

# --- OpenRouter attribution headers (optional, not secret) -----------------
# OpenRouter's docs recommend sending these to identify the calling app.
OPENROUTER_SITE_URL=https://github.com/iamvisheshsrivastava/spec2program
OPENROUTER_SITE_NAME=spec2program

# --- Application settings ---------------------------------------------------
# CORS origins allowed to call the API (comma-separated). "*" allows all.
CORS_ORIGINS=*
